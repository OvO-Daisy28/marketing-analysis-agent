        <mxCell id="node0" value="营销运营人员&#10;确认分析范围&#10;核对证据、确认发布" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#F4F6F8;strokeColor=#475569;fontColor=#475569;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="36" y="170" width="215" height="110" as="geometry" />
        </mxCell>
        <mxCell id="node1" value="工作台与 FastAPI&#10;身份 / 版本 / SSE 事件&#10;增强：发布审查与完整快照" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#FFF7E8;strokeColor=#B45309;fontColor=#B45309;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="node2" value="新增 TaskContract 服务&#10;原始需求与生效范围分离&#10;提案版本、确认与兼容检查" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#FFF7E8;strokeColor=#B45309;fontColor=#B45309;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="node3" value="外部模型 API&#10;理解问题、选择工具&#10;不确认业务发布&#10;不决定服务端身份" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#F4F6F8;strokeColor=#475569;fontColor=#475569;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="36" y="390" width="215" height="140" as="geometry" />
        </mxCell>
        <mxCell id="node4" value="增强 Worker 运行时&#10;ContextBuilder 注入合同&#10;ToolRegistry 校验任务范围&#10;研究 Loop 与报表 Skill" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#FFF7E8;strokeColor=#B45309;fontColor=#B45309;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="330" y="390" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="node5" value="PostgreSQL&#10;目标、Run、证据、结论&#10;新增：合同、审阅信息&#10;扩展：完整交付快照" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#EAF6F3;strokeColor=#0F766E;fontColor=#0F766E;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="760" y="390" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="API 将任务写入数据库，Worker 领取执行；图中双向直线表示请求与返回或读写关系。" style="text;html=0;align=left;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="36" y="595" width="1048" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="新增范围治理、证据适用性检查及完整发布快照尚未实现，需按验收场景验证。" style="text;html=0;align=left;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
